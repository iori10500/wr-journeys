<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= metaDescription %>">
  <link rel="canonical" href="https://itinerary.wildroadgroup.com<%= lang === 'en' ? '/en' : '' %>/destinations/china/<%= city.slug %>">
  <link rel="alternate" hreflang="zh-CN" href="https://itinerary.wildroadgroup.com/destinations/china/<%= city.slug %>">
  <link rel="alternate" hreflang="en" href="https://itinerary.wildroadgroup.com/en/destinations/china/<%= city.slug %>">
  <link rel="alternate" hreflang="x-default" href="https://itinerary.wildroadgroup.com/en/destinations/china/<%= city.slug %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:url" content="https://itinerary.wildroadgroup.com<%= lang === 'en' ? '/en' : '' %>/destinations/china/<%= city.slug %>">
  <meta property="og:image" content="<%= cdnImage(city.hero, 1600) %>">
  <meta property="og:type" content="website">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/fonts/fonts.css">
  <link rel="stylesheet" href="/main.css?v=20260810a">
  <link rel="stylesheet" href="/enquiry.css?v=20260806">
  <link rel="stylesheet" href="/china-inbound.css?v=20260806d">
  <% if (cityRoutes.length) { %><link rel="stylesheet" href="/chongqing.css?v=20260914"><% } %>
  <%- include('partials/jsonld') %>
  <%- include('partials/ga') %>
  <script src="/cdn-fallback.js" defer></script>
</head>
<body class="china-page china-city-page china-city-page--<%= city.slug %>">
  <%- include('partials/header') %>
  <a class="lang-toggle" href="<%= lang === 'en' ? '' : '/en' %>/destinations/china/<%= city.slug %>" hreflang="<%= lang === 'en' ? 'zh-CN' : 'en' %>"><%= lang === 'en' ? '中' : 'EN' %></a>

  <main>
    <section class="china-city-hero">
      <picture class="china-city-hero__media" aria-hidden="true">
        <source srcset="<%= cdnImage(city.hero.replace(/\.jpg$/, '.webp'), 1600) %>" type="image/webp">
        <img src="<%= cdnImage(city.hero, 1600) %>" alt="" loading="eager">
      </picture>
      <div class="china-city-hero__veil"></div>
      <div class="china-city-hero__inner">
        <nav class="china-back" aria-label="Breadcrumb"><a href="<%= lang === 'en' ? '/en' : '' %>/destinations/china"><%= lang === 'en' ? 'China' : '中国' %></a> / <%= lang === 'en' ? city.name_en : city.name_zh %></nav>
        <p class="china-kicker"><%= lang === 'en' ? 'PRIVATE CITY JOURNEY · HUMAN-LED' : '城市私人旅程 · 真人全程服务' %></p>
        <h1><%= lang === 'en' ? city.headline_en : city.headline_zh %></h1>
        <p class="china-city-hero__lead"><%= lang === 'en' ? city.lead_en : city.lead_zh %></p>
        <div class="china-actions">
          <a class="china-button china-button--primary" href="<%= advisorUrl(lang, { source: 'china-city-' + city.slug }) %>" data-enquiry-cta="china-city-hero"><%= lang === 'en' ? 'Plan my ' + city.name_en + ' stay' : '规划我的' + city.name_zh + '旅程' %> <span>→</span></a>
          <a class="china-button china-button--ghost" href="<%= cityRoutes.length ? '#sample-journeys' : '#city-rhythm' %>"><%= cityRoutes.length ? (lang === 'en' ? 'Compare three journeys' : '比较三条参考线路') : (lang === 'en' ? 'See our approach' : '查看我们的安排方式') %></a>
        </div>
      </div>
      <div class="china-photo-credit"><a href="<%= city.photo_url %>" target="_blank" rel="noopener"><%= city.photo_credit %></a><% if (city.photo_license_url) { %> · <a href="<%= city.photo_license_url %>" target="_blank" rel="noopener"><%= lang === 'en' ? 'License · resized / display crop' : '许可 · 已缩放及版面裁切' %></a><% } %></div>
    </section>

    <section class="china-city-facts" aria-label="<%= lang === 'en' ? 'Planning summary' : '规划摘要' %>">
      <article><span><%= lang === 'en' ? 'IDEAL FIRST STAY' : '初次建议停留' %></span><strong><%= lang === 'en' ? city.stay_en : city.stay_zh %></strong></article>
      <article><span><%= lang === 'en' ? 'ROLE IN THE JOURNEY' : '在旅程中的角色' %></span><strong><%= lang === 'en' ? city.role_en : city.role_zh %></strong></article>
      <article><span><%= lang === 'en' ? 'PAIR IT WITH' : '适合连线' %></span><strong><%= lang === 'en' ? city.pair_en : city.pair_zh %></strong></article>
    </section>

    <section class="china-city-overview" id="city-rhythm">
      <div class="china-city-overview__title"><p class="china-kicker"><%= lang === 'en' ? 'HOW TO READ THE CITY' : '如何进入这座城市' %></p><h2><%= lang === 'en' ? 'Give the city enough time to change register.' : '给城市足够时间，显露不同层次。' %></h2></div>
      <div class="china-city-overview__copy"><% (lang === 'en' ? city.overview_en : city.overview_zh).forEach(function(p) { %><p><%= p %></p><% }); %></div>
    </section>

    <% if (cityRoutes.length) { %><%- include('partials/city-samples', { cityRoutes, city, lang }) %><% } %>

    <section class="china-city-moments">
      <header><p class="china-kicker"><%= lang === 'en' ? 'THREE CHAPTERS' : '三个章节' %></p><h2><%= lang === 'en' ? 'What belongs in a considered stay.' : '一段经过取舍的停留，应当包含什么。' %></h2></header>
      <div class="china-city-moments__grid">
        <% (lang === 'en' ? city.moments_en : city.moments_zh).forEach(function(moment, index) { %>
        <article><span>0<%= index + 1 %></span><h3><%= moment.title %></h3><p><%= moment.text %></p></article>
        <% }); %>
      </div>
    </section>

    <section class="china-city-human">
      <div><p class="china-kicker"><%= lang === 'en' ? 'ONE ADVISOR, END TO END' : '同一位顾问，从开始到结束' %></p><h2><%= lang === 'en' ? 'The useful work happens between the landmarks.' : '真正有用的服务，发生在景点之间。' %></h2></div>
      <div><p><%= lang === 'en' ? 'Timed admissions, hotel geography, transfer windows, walking tolerance, meals and a change of plan on a difficult day: one real person keeps these decisions connected.' : '实名预约、酒店位置、转场窗口、步行体力、用餐，以及某一天临时改变计划：由同一位真人顾问把这些决定持续连接起来。' %></p><p><%= lang === 'en' ? 'AI helps us organise and communicate faster. It does not replace listening, local judgement or responsibility for your journey.' : 'AI 帮助我们更快整理和沟通，但不会替代聆听、在地判断，也不会替代对旅程的责任。' %></p></div>
    </section>

    <section class="china-city-links">
      <header><p class="china-kicker"><%= lang === 'en' ? 'BUILD THE NEXT CHAPTER' : '连接下一章节' %></p><h2><%= lang === 'en' ? 'Different city openings. One coherent China journey.' : '从不同城市出发，组成一段连贯的中国旅程。' %></h2></header>
      <div class="china-city-links__grid">
        <% Object.entries(cities).forEach(function(entry) { var slug = entry[0], other = entry[1]; %>
        <a class="<%= slug === city.slug ? 'is-current' : '' %>" href="<%= lang === 'en' ? '/en' : '' %>/destinations/china/<%= slug %>"><span><%= slug === city.slug ? (lang === 'en' ? 'YOU ARE HERE' : '当前位置') : (lang === 'en' ? 'EXPLORE' : '继续探索') %></span><h3><%= lang === 'en' ? other.name_en : other.name_zh %></h3><p><%= lang === 'en' ? other.role_en : other.role_zh %></p><i>↗</i></a>
        <% }); %>
      </div>
      <div class="china-city-guide-link"><a href="<%= lang === 'en' ? '/en' : '' %>/guides/first-trip-to-china"><%= lang === 'en' ? 'Not sure where to begin? Read our first-trip guide for 10, 14 and 21 days.' : '还不确定从哪里开始？查看 10、14 与 21 天第一次来华旅行指南。' %> <span>→</span></a></div>
    </section>

    <section class="china-faq">
      <header><p><%= lang === 'en' ? city.name_en.toUpperCase() + ' QUESTIONS' : city.name_zh + '常见问题' %></p><h2><%= lang === 'en' ? 'Useful answers before we talk.' : '沟通之前，先回答几个问题。' %></h2></header>
      <div><% (lang === 'en' ? city.faq_en : city.faq_zh).forEach(function(item) { %><details><summary><%= item.q %></summary><p><%= item.a %></p></details><% }); %></div>
    </section>

    <section class="china-enquiry">
      <div class="china-enquiry__copy"><p class="china-kicker"><%= lang === 'en' ? 'START WITH ' + city.name_en.toUpperCase() : '从' + city.name_zh + '开始' %></p><h2><%= lang === 'en' ? 'Tell us what should feel effortless.' : '告诉我们，哪些部分应该由我们替你变得轻松。' %></h2><p><%= lang === 'en' ? 'A rough month, your party and one thing you care about are enough for a real advisor to begin.' : '一个大致月份、同行者，以及一件你真正重视的事，就足够让真人顾问开始规划。' %></p></div>
      <div class="china-enquiry__form"><%- include('partials/enquiry-form', { variant: 'short', source: 'china-city-' + city.slug, route: null }) %></div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
