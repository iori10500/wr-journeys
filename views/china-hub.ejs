<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= metaDescription %>">
  <link rel="canonical" href="https://itinerary.wildroadgroup.com<%= lang === 'en' ? '/en' : '' %>/destinations/china">
  <link rel="alternate" hreflang="zh-CN" href="https://itinerary.wildroadgroup.com/destinations/china">
  <link rel="alternate" hreflang="en" href="https://itinerary.wildroadgroup.com/en/destinations/china">
  <link rel="alternate" hreflang="x-default" href="https://itinerary.wildroadgroup.com/en/destinations/china">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:url" content="https://itinerary.wildroadgroup.com<%= lang === 'en' ? '/en' : '' %>/destinations/china">
  <meta property="og:image" content="<%= cdnImage('/images/chengdu-dali-lijiang-14d/cover.jpg', 1600) %>">
  <meta property="og:type" content="website">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/fonts/fonts.css">
  <link rel="stylesheet" href="/main.css?v=20260801">
  <link rel="stylesheet" href="/enquiry.css?v=20260806">
  <link rel="stylesheet" href="/china-inbound.css?v=20260806d">
  <%- include('partials/jsonld') %>
  <%- include('partials/ga') %>
  <script src="/cdn-fallback.js" defer></script>
</head>
<body class="china-page china-hub-page">
  <%- include('partials/header') %>
  <a class="lang-toggle" href="<%= lang === 'en' ? '/destinations/china' : '/en/destinations/china' %>" hreflang="<%= lang === 'en' ? 'zh-CN' : 'en' %>"><%= lang === 'en' ? '中' : 'EN' %></a>

  <main>
    <section class="china-hero china-hero--hub">
      <picture class="china-hero__media" aria-hidden="true">
        <source srcset="<%= cdnImage('/images/chengdu-dali-lijiang-14d/cover.webp', 1600) %>" type="image/webp">
        <img src="<%= cdnImage('/images/chengdu-dali-lijiang-14d/cover.jpg', 1600) %>" alt="" loading="eager">
      </picture>
      <div class="china-hero__veil"></div>
      <div class="china-hero__inner">
        <div class="china-hero__copy">
          <a class="china-back" href="<%= lang === 'en' ? '/en' : '' %>/destinations"><%= lang === 'en' ? 'Destinations / China' : '目的地 / 中国' %></a>
          <p class="china-kicker"><%= lang === 'en' ? 'PRIVATE CHINA JOURNEYS · HUMAN-LED' : '中国入境定制 · 真人全程服务' %></p>
          <h1><%= lang === 'en' ? 'Private journeys through a China worth slowing down for.' : '在值得慢下来的中国，完成一段真正属于你的旅程。' %></h1>
          <p class="china-hero__lead"><%= lang === 'en' ? 'From Guizhou mountain lodges to Yunnan, Shangri-La and western Sichuan, one real advisor listens first, shapes every detail and stays with you through your return.' : '从贵州山野、云南苍洱到香格里拉与川西，由同一位真人顾问先聆听需求，再规划细节，并持续跟进到旅行归来。' %></p>
          <div class="china-actions">
            <a class="china-button china-button--primary" href="<%= advisorUrl(lang, { source: 'china-hub-hero' }) %>" data-enquiry-cta="china-hub-hero"><%= lang === 'en' ? 'Plan my China journey' : '开始规划中国旅程' %><span>→</span></a>
            <a class="china-button china-button--quiet" href="#routes"><%= lang === 'en' ? 'Explore sample journeys' : '浏览参考线路' %></a>
          </div>
          <p class="china-microcopy"><%= lang === 'en' ? 'A considered reply within 24 hours · Complimentary planning until you book' : '工作时间内尽快回复 · 确认落单前规划不收费' %></p>
        </div>
        <aside class="china-promise" aria-label="<%= lang === 'en' ? 'Our planning promise' : '我们的规划承诺' %>">
          <div><span>01</span><p><strong><%= lang === 'en' ? 'A real person, from start to finish' : '真人从开始跟到结束' %></strong><%= lang === 'en' ? 'No automated itinerary hand-off.' : '不会把行程交给自动系统。' %></p></div>
          <div><span>02</span><p><strong><%= lang === 'en' ? 'China hospitality, known from inside' : '真正理解中国酒店与在地资源' %></strong><%= lang === 'en' ? 'Boutique founders, local operators and trusted guides.' : '连接精品酒店主理人、在地执行者与可信向导。' %></p></div>
          <div><span>03</span><p><strong><%= lang === 'en' ? 'AI makes us faster. Listening makes it yours.' : 'AI 提高效率，聆听决定旅程' %></strong><%= lang === 'en' ? 'Technology supports the work; judgement stays human.' : '技术协助整理与联络，取舍始终由真人负责。' %></p></div>
        </aside>
      </div>
    </section>

    <section class="china-editorial">
      <div class="china-editorial__label"><span>WR</span><%= lang === 'en' ? 'Why travel China with us' : '为什么和我们探索中国' %></div>
      <div class="china-editorial__body">
        <% (lang === 'en' ? china.manifesto_en : china.manifesto_zh).split(/\n\n+/).forEach(function(para) { %><p><%= para %></p><% }); %>
      </div>
    </section>

    <section class="china-first-entry">
      <div>
        <p class="china-kicker"><%= lang === 'en' ? 'FIRST TIME IN CHINA?' : '第一次来中国？' %></p>
        <h2><%= lang === 'en' ? 'Start with time, not a checklist.' : '先确定时间与节奏，不必先列打卡清单。' %></h2>
      </div>
      <div>
        <p><%= lang === 'en' ? 'See what genuinely fits into 10, 14 or 21 days, plus the practical entry, payment and rail details that make a first journey feel clear.' : '了解 10、14 或 21 天真正适合怎样安排，以及入境、支付与铁路出行等让第一趟旅程更从容的实用信息。' %></p>
        <a href="<%= lang === 'en' ? '/en' : '' %>/guides/first-trip-to-china"><%= lang === 'en' ? 'Read the first-trip guide' : '查看第一次来华旅行指南' %> <span>→</span></a>
      </div>
    </section>

    <section class="china-section china-hub-cities">
      <header class="china-section__head"><p><%= lang === 'en' ? 'GATEWAY CITIES' : '门户城市' %></p><h2><%= lang === 'en' ? 'Begin with the China you want to understand.' : '从你最想理解的中国开始。' %></h2></header>
      <div class="china-hub-city-grid">
        <% Object.entries(cities).forEach(function(entry) { var slug = entry[0], city = entry[1]; %>
        <a href="<%= lang === 'en' ? '/en' : '' %>/destinations/china/<%= slug %>"><span><%= lang === 'en' ? 'PRIVATE CITY JOURNEY' : '城市私人旅程' %></span><h3><%= lang === 'en' ? city.name_en : city.name_zh %></h3><p><%= lang === 'en' ? city.role_en : city.role_zh %> →</p></a>
        <% }); %>
      </div>
    </section>

    <section class="china-method" aria-label="<%= lang === 'en' ? 'How we plan' : '我们的规划方式' %>">
      <article><span>Listen</span><h2><%= lang === 'en' ? 'We begin with the way you want to feel.' : '先理解你希望这段旅程是什么感受。' %></h2><p><%= lang === 'en' ? 'Pace, sleep, food, children, mobility and what you would rather leave out.' : '节奏、睡眠、饮食、儿童、体力，以及你不想安排的部分。' %></p></article>
      <article><span>Shape</span><h2><%= lang === 'en' ? 'We build one coherent journey.' : '把住宿、交通与体验连成完整旅程。' %></h2><p><%= lang === 'en' ? 'Hotels, transfers, guides and local experiences are designed as one story—not separate bookings.' : '不是零散预订，而是围绕同一目标完成路线、住宿、车辆与在地体验。' %></p></article>
      <article><span>Stay</span><h2><%= lang === 'en' ? 'The same person stays involved.' : '由同一位顾问持续跟进。' %></h2><p><%= lang === 'en' ? 'From the first conversation to the moment you return home.' : '从第一次沟通、出发前确认，到旅途中协调及旅行归来。' %></p></article>
    </section>

    <section class="china-section china-regions">
      <header class="china-section__head"><p><%= lang === 'en' ? 'FOUR WAYS INTO SOUTHWEST CHINA' : '进入中国西南的四种方式' %></p><h2><%= lang === 'en' ? 'Choose a landscape. We will find the right pace.' : '先选择一片山河，再找到适合你的节奏。' %></h2></header>
      <div class="china-region-grid">
        <% subRegions.forEach(function(r, index) { %>
        <a class="china-region-card" href="<%= lang === 'en' ? '/en' : '' %>/destinations/china/<%= r.slug %>">
          <span class="china-card-index">0<%= index + 1 %></span>
          <div><p><%= lang === 'en' ? r.name_en : r.name_zh %></p><h3><%= lang === 'en' ? r.headline_en : r.headline_zh %></h3></div>
          <footer><%= r.routeCount > 0 ? r.routeCount + (lang === 'en' ? ' curated journeys' : ' 条甄选线路') : (lang === 'en' ? 'Bespoke, by request' : '一事一议') %><span>↗</span></footer>
        </a>
        <% }); %>
      </div>
    </section>

    <% if (featuredRoutes && featuredRoutes.length) { %>
    <section class="china-section china-routes" id="routes">
      <header class="china-section__head"><p><%= lang === 'en' ? 'JOURNEYS TO BEGIN WITH' : '从这些旅程开始' %></p><h2><%= lang === 'en' ? 'Reference routes, never fixed packages.' : '它们是灵感，不是不能修改的标准团。' %></h2></header>
      <div class="china-route-grid">
        <% featuredRoutes.forEach(function(r) { %>
        <a class="china-route-card" href="<%= lang === 'en' ? '/en' : '' %>/routes/<%= r.slug %>">
          <picture><source srcset="<%= cdnImage(r.hero_path.replace(/\.jpg$/, '.webp'), 800) %>" type="image/webp"><img src="<%= cdnImage(r.hero_path, 800) %>" alt="<%= lang === 'en' ? r.title_en : r.title_zh %>" loading="lazy" decoding="async"></picture>
          <div class="china-route-card__copy"><p><%= lang === 'en' ? r.region_en : r.region_zh %> · <%= lang === 'en' ? r.duration_en : r.duration_zh %></p><h3><%= lang === 'en' ? r.title_en : r.title_zh %></h3><span><%= lang === 'en' ? 'See the journey' : '查看旅程' %> →</span></div>
        </a>
        <% }); %>
      </div>
    </section>
    <% } %>

    <section class="china-faq">
      <header><p><%= lang === 'en' ? 'BEFORE WE BEGIN' : '开始之前' %></p><h2><%= lang === 'en' ? 'A few useful answers.' : '几个常见问题。' %></h2></header>
      <div>
        <details><summary><%= lang === 'en' ? 'Can you plan a first trip to China?' : '第一次来中国，也可以规划吗？' %></summary><p><%= lang === 'en' ? 'Yes. We can build a clear first journey around your time, interests and comfort with distance—without compressing China into a checklist.' : '可以。我们会根据时间、兴趣和对长距离移动的接受程度设计第一趟中国旅行，不把中国压缩成打卡清单。' %></p></details>
        <details><summary><%= lang === 'en' ? 'Is every itinerary private and customisable?' : '所有行程都是私人定制吗？' %></summary><p><%= lang === 'en' ? 'Our published routes are starting points. Dates, hotels, pace, guides, vehicles and experiences can be reshaped around your party.' : '公开线路只是起点，日期、住宿、节奏、向导、车辆与体验都可围绕同行者调整。' %></p></details>
        <details><summary><%= lang === 'en' ? 'What does WR Journeys arrange?' : 'WR Journeys 可以安排哪些内容？' %></summary><p><%= lang === 'en' ? 'Depending on the brief: boutique and luxury stays, private transfers, trusted local guides, experiences and the practical coordination that holds the journey together.' : '根据实际需求，可安排精品及奢华住宿、私人接送、可信在地向导、特色体验，以及串联整段旅程的协调工作。' %></p></details>
        <details><summary><%= lang === 'en' ? 'Will I speak to a real person?' : '我会直接与真人沟通吗？' %></summary><p><%= lang === 'en' ? 'Always. AI helps us organise information and coordinate faster, but listening, route judgement and end-to-end care remain with a real advisor.' : '会。AI 只帮助我们更快整理信息和协调资源；需求聆听、路线判断与从开始到结束的服务始终由真人顾问负责。' %></p></details>
      </div>
    </section>

    <section class="china-enquiry" id="china-enquiry">
      <div class="china-enquiry__copy"><p class="china-kicker"><%= lang === 'en' ? 'START WITH ONE IDEA' : '从一个想法开始' %></p><h2><%= lang === 'en' ? 'Tell us what China should feel like to you.' : '告诉我们，你希望在中国感受到什么。' %></h2><p><%= lang === 'en' ? 'You do not need a finished brief. A rough month, one place or a feeling is enough for a real advisor to begin.' : '不需要准备完整需求。一个大致月份、一个地方，或一种期待，就足够让真人顾问开始规划。' %></p></div>
      <div class="china-enquiry__form"><%- include('partials/enquiry-form', { variant: 'short', source: 'china-hub', route: null }) %></div>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
