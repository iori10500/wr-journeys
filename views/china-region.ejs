<% var regionHero = ({
  guizhou: '/images/brands/jianglu/guizhou-liangdu-shishi-hero.webp',
  yunnan: '/images/brands/jianglu/dali-shanfeng-yaoyu-hero.webp',
  'shangri-la': '/images/brands/jianglu/shangrila-xueshan-jiuzhuang-hero.webp',
  sichuan: '/images/chengdu-dali-lijiang-14d/six-senses-1.webp'
})[region.slug] || '/images/chengdu-dali-lijiang-14d/cover.webp'; %>
<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= metaDescription %>">
  <link rel="canonical" href="https://itinerary.wildroadgroup.com<%= lang === 'en' ? '/en' : '' %>/destinations/china/<%= region.slug %>">
  <link rel="alternate" hreflang="zh-CN" href="https://itinerary.wildroadgroup.com/destinations/china/<%= region.slug %>">
  <link rel="alternate" hreflang="en" href="https://itinerary.wildroadgroup.com/en/destinations/china/<%= region.slug %>">
  <link rel="alternate" hreflang="x-default" href="https://itinerary.wildroadgroup.com/en/destinations/china/<%= region.slug %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:url" content="https://itinerary.wildroadgroup.com<%= lang === 'en' ? '/en' : '' %>/destinations/china/<%= region.slug %>">
  <meta property="og:image" content="<%= cdnImage(regionHero.replace(/\.webp$/, '.jpg'), 1600) %>">
  <meta property="og:type" content="website">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/fonts/fonts.css">
  <link rel="stylesheet" href="/main.css?v=20260801">
  <link rel="stylesheet" href="/china-inbound.css?v=20260806d">
  <%- include('partials/jsonld') %>
  <%- include('partials/ga') %>
  <script src="/cdn-fallback.js" defer></script>
</head>
<body class="china-page china-region-page">
  <%- include('partials/header') %>
  <a class="lang-toggle" href="<%= lang === 'en' ? '/destinations/china/' + region.slug : '/en/destinations/china/' + region.slug %>" hreflang="<%= lang === 'en' ? 'zh-CN' : 'en' %>"><%= lang === 'en' ? '中' : 'EN' %></a>

  <main>
    <section class="china-hero china-hero--region">
      <img class="china-hero__media" src="<%= cdnImage(regionHero, 1600) %>" alt="<%= lang === 'en' ? region.name_en : region.name_zh %>" loading="eager">
      <div class="china-hero__veil"></div>
      <div class="china-hero__inner china-hero__inner--region">
        <div class="china-hero__copy">
          <nav class="china-back" aria-label="Breadcrumb"><a href="<%= lang === 'en' ? '/en' : '' %>/destinations/china"><%= lang === 'en' ? 'China' : '中国' %></a> / <%= lang === 'en' ? region.name_en : region.name_zh %></nav>
          <p class="china-kicker"><%= lang === 'en' ? 'PRIVATE CHINA JOURNEYS' : '中国入境私人旅程' %></p>
          <h1><%= lang === 'en' ? region.headline_en : region.headline_zh %></h1>
          <p class="china-hero__lead"><%= lang === 'en' ? 'Designed around your pace, interests and the people travelling with you—with a real advisor throughout.' : '围绕你的节奏、兴趣与同行者设计，并由真人顾问持续跟进整段旅程。' %></p>
          <div class="china-actions">
            <a class="china-button china-button--primary" href="<%= advisorUrl(lang, { source: 'china-region-' + region.slug }) %>" data-enquiry-cta="china-region-hero"><%= lang === 'en' ? 'Plan a private ' + region.name_en + ' journey' : '规划' + region.name_zh + '私人旅程' %><span>→</span></a>
            <% if (routes && routes.length) { %><a class="china-button china-button--quiet" href="#routes"><%= lang === 'en' ? 'See routes' : '查看线路' %></a><% } %>
          </div>
        </div>
      </div>
    </section>

    <section class="china-editorial china-editorial--region">
      <div class="china-editorial__label"><span><%= region.name_en.substring(0, 2).toUpperCase() %></span><%= lang === 'en' ? 'Our view of the region' : '我们如何理解这里' %></div>
      <div class="china-editorial__body"><% (lang === 'en' ? region.manifesto_en : region.manifesto_zh).split(/\n\n+/).forEach(function(para) { %><p><%= para %></p><% }); %>
        <div class="china-partner-note"><strong><%= lang === 'en' ? 'Hospitality anchors' : '在地住宿伙伴' %></strong><span><% if (region.slug !== 'sichuan') { %><a href="<%= lang === 'en' ? '/en' : '' %>/brands/jianglu"><%= lang === 'en' ? 'Jianglu' : '匠庐' %></a> · <% } %><a href="<%= lang === 'en' ? '/en' : '' %>/brands/songtsam"><%= lang === 'en' ? 'Songtsam' : '松赞' %></a></span></div>
      </div>
    </section>

    <% if (region.slug === 'yunnan') { %><section class="china-section" aria-label="<%= lang === 'en' ? 'Southern Yunnan' : '云南南部' %>"><header class="china-section__head"><p><%= lang === 'en' ? 'ANOTHER SIDE OF YUNNAN' : '云南的另一面' %></p><h2><%= lang === 'en' ? 'Head south, into the rainforest.' : '一路向南，走进西双版纳。' %></h2></header><a class="china-button china-button--primary" href="<%= urlFor('/destinations/china/xishuangbanna', lang) %>"><%= lang === 'en' ? 'Explore Xishuangbanna · 5 days / 4 nights' : '探索西双版纳 · 5天4晚参考行程' %> →</a></section><% } %>
    <section class="china-section china-routes" id="routes">
      <header class="china-section__head"><p><%= lang === 'en' ? 'CURATED STARTING POINTS' : '甄选出发点' %></p><h2><%= routes && routes.length ? (lang === 'en' ? 'Routes to make your own.' : '把参考线路，改成你的旅程。') : (lang === 'en' ? 'Built privately, on request.' : '暂不设标准路线，一事一议设计。') %></h2></header>
      <% if (routes && routes.length) { %>
      <div class="china-route-grid">
        <% routes.forEach(function(r) { %><a class="china-route-card" href="<%= lang === 'en' ? '/en' : '' %>/routes/<%= r.slug %>"><picture><source srcset="<%= cdnImage(r.hero_path.replace(/\.jpg$/, '.webp'), 800) %>" type="image/webp"><img src="<%= cdnImage(r.hero_path, 800) %>" alt="<%= lang === 'en' ? r.title_en : r.title_zh %>" loading="lazy" decoding="async"></picture><div class="china-route-card__copy"><p><%= lang === 'en' ? r.duration_en : r.duration_zh %></p><h3><%= lang === 'en' ? r.title_en : r.title_zh %></h3><span><%= lang === 'en' ? 'See the journey' : '查看旅程' %> →</span></div></a><% }); %>
      </div>
      <% } else { %>
      <div class="china-empty"><p><%= lang === 'en' ? 'Public routes are still being prepared. A real advisor can already shape a private journey around your dates, fitness, photography or family needs.' : '公开线路仍在整理中。真人顾问已经可以围绕日期、体力、摄影或亲子需求，一事一议设计私人旅程。' %></p><a href="<%= advisorUrl(lang, { source: 'china-region-empty-' + region.slug }) %>" data-enquiry-cta="china-region-empty"><%= lang === 'en' ? 'Ask an advisor' : '联系顾问' %> →</a></div>
      <% } %>
    </section>

    <section class="china-closing">
      <p class="china-kicker"><%= lang === 'en' ? 'A HUMAN-LED JOURNEY' : '由真人带领的旅程' %></p>
      <h2><%= lang === 'en' ? 'Keep the destination. Change every detail.' : '保留目的地，重写每一个细节。' %></h2>
      <p><%= lang === 'en' ? 'AI helps us coordinate faster. Listening, judgement and end-to-end care remain with your advisor.' : 'AI 帮助我们更快协调；聆听、判断与从开始到结束的服务始终由顾问负责。' %></p>
      <a class="china-button china-button--primary" href="<%= advisorUrl(lang, { source: 'china-region-closing-' + region.slug }) %>" data-enquiry-cta="china-region-closing"><%= lang === 'en' ? 'Start a conversation' : '开始沟通' %><span>→</span></a>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
