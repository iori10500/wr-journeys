<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-XKZF4QMVD4"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('set', 'linker', { domains: ['wr-travel.com', 'wildroadgroup.com'], accept_incoming: true });
  gtag('set', {
    site_hostname: location.hostname,
    content_group: '<%= typeof contentGroup !== "undefined" ? contentGroup : "wr_journeys" %>',
    brand: 'WR Travel'
  });
  window.WRAnalyticsContext = {
    content_group: '<%= typeof contentGroup !== "undefined" ? contentGroup : "wr_journeys" %>',
    landing_path: '<%= typeof analyticsLandingPath !== "undefined" && analyticsLandingPath ? analyticsLandingPath : "" %>' || location.pathname,
    page_path: location.pathname,
    page_language: '<%= lang %>'
  };
  gtag('config', 'G-XKZF4QMVD4');
  (function () {
    try {
      var utmSource = new URLSearchParams(location.search).get('utm_source') || '';
      var referrerHost = document.referrer ? new URL(document.referrer).hostname : '';
      var source = String(utmSource || referrerHost).toLowerCase();
      var providers = [
        ['openai', /chatgpt|openai|oai-searchbot/], ['perplexity', /perplexity/],
        ['copilot', /copilot/], ['gemini', /gemini|bard/], ['claude', /claude|anthropic/],
        ['you.com', /you\.com/], ['meta.ai', /meta\.ai/], ['doubao', /doubao|toutiao|bytedance/],
        ['deepseek', /deepseek/], ['kimi', /kimi|moonshot/], ['qwen', /qwen|tongyi/],
        ['grok', /grok|x\.ai/]
      ];
      var provider = providers.find(function (item) { return item[1].test(source); });
      if (provider) gtag('event', 'ai_referral_landing', {
        ai_source: provider[0],
        referral_method: utmSource ? 'utm' : 'referrer',
        landing_path: location.pathname,
        content_group: window.WRAnalyticsContext.content_group,
        non_interaction: true
      });
    } catch (_) {}
  })();
</script>
<script src="/enquiry.js" defer></script>
<% if (turnstileSiteKey) { %><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% } %>
