<div class="xb-gallery">
<% photos.forEach(function(photo) { %>
  <figure class="xb-shot">
    <a class="xb-photo-link" href="<%= photo.path %>" target="_blank" rel="noopener" aria-label="<%= (lang === 'en' ? 'Open photograph: ' : '查看大图：') + (lang === 'en' ? photo.caption_en : photo.caption_zh) %>"><picture><source srcset="<%= photo.path.replace(/\.jpg$/, '.webp') %>" type="image/webp"><img src="<%= photo.path %>" alt="<%= lang === 'en' ? photo.caption_en : photo.caption_zh %>" loading="lazy" decoding="async"></picture><span aria-hidden="true">↗</span></a>
    <figcaption><span><%= lang === 'en' ? photo.caption_en : photo.caption_zh %></span><small><a href="<%= photo.source %>" target="_blank" rel="noopener"><%= photo.credit %></a><% if (photo.license) { %> · <a href="<%= photo.license_url %>" target="_blank" rel="noopener"><%= photo.license %></a><% } %></small></figcaption>
  </figure>
<% }); %>
</div>
