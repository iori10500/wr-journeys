<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (lang === 'en' ? route.title_en : route.title_zh) %> | WR Journeys</title>
  <meta name="description" content="<%= lang === 'en' ? route.subtitle_en : route.subtitle_zh %>">
  <link rel="canonical" href="https://itinerary.wildroadgroup.com<%= lang === 'en' ? '/en' : '' %>/routes/<%= route.slug %>">
  <link rel="alternate" hreflang="zh-CN" href="https://itinerary.wildroadgroup.com/routes/<%= route.slug %>">
  <link rel="alternate" hreflang="en" href="https://itinerary.wildroadgroup.com/en/routes/<%= route.slug %>">
  <link rel="alternate" hreflang="x-default" href="https://itinerary.wildroadgroup.com/routes/<%= route.slug %>">
  <meta property="og:title" content="<%= (lang === 'en' ? route.title_en : route.title_zh) %> | WR Journeys">
  <meta property="og:url" content="https://itinerary.wildroadgroup.com<%= lang === 'en' ? '/en' : '' %>/routes/<%= route.slug %>">
  <meta property="og:image" content="<%= cdnImage(route.hero_path, 1600) %>">
  <meta property="og:type" content="article">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico">
  <link rel="stylesheet" href="/fonts/fonts.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/main.css?v=20260810a">
  <link rel="stylesheet" href="/enquiry.css">
  <%- include('partials/jsonld') %>
  <style>
    .r-hero { position:relative; height:62vh; min-height:380px; overflow:hidden; background:#1a1a2e; }
    .r-hero picture, .r-hero img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
    .r-hero .scrim { position:absolute; inset:0; background:linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.25) 40%, rgba(0,0,0,0.75) 100%); }
    .r-hero .inner { position:relative; z-index:2; max-width:980px; margin:0 auto; padding:0 24px; height:100%; display:flex; flex-direction:column; justify-content:flex-end; padding-bottom:48px; color:#fff; }
    .r-hero .breadcrumb { font-size:12px; letter-spacing:0.12em; color:rgba(255,255,255,0.7); margin-bottom:12px; }
    .r-hero .breadcrumb a { color:#c8a96e; text-decoration:none; }
    .r-hero h1 { font-family:'Playfair Display',serif; font-size:38px; margin:0 0 10px; line-height:1.2; }
    .r-hero .subtitle { font-size:16px; color:rgba(255,255,255,0.85); max-width:720px; }
    .r-meta { background:#0e0e1a; padding:18px 24px; }
    .r-meta-inner { max-width:980px; margin:0 auto; display:flex; flex-wrap:wrap; gap:24px 36px; color:rgba(255,255,255,0.85); font-size:13px; }
    .r-meta-inner b { color:#c8a96e; font-weight:600; margin-right:6px; }
    .r-body { max-width:760px; margin:0 auto; padding:48px 24px 80px; font-size:16px; line-height:1.85; color:#222; }
    .r-tags { display:flex; flex-wrap:wrap; gap:8px; margin:0 0 28px; }
    .r-tags span { background:#f7f5f0; color:#8a7144; padding:6px 14px; border-radius:50px; font-size:12px; }
    .r-intro { font-size:17px; line-height:1.85; color:#444; margin-bottom:40px; padding:24px; background:#fafafa; border-left:3px solid #c8a96e; border-radius:0 8px 8px 0; }
    .r-section-title { font-family:'Playfair Display',serif; font-size:24px; color:#1a1a2e; margin:48px 0 24px; border-bottom:1px solid #e8e5dd; padding-bottom:12px; }
    .r-day { margin-bottom:32px; }
    .r-day-head { font-family:'Playfair Display',serif; font-size:18px; color:#c8a96e; margin:0 0 14px; padding-left:16px; border-left:3px solid #c8a96e; }
    .r-day-item { padding:14px 0 14px 18px; border-bottom:1px dashed #e8e5dd; }
    .r-day-item:last-child { border-bottom:none; }
    .r-day-item h4 { font-size:16px; color:#1a1a2e; margin:0 0 6px; font-weight:500; }
    .r-day-item p { font-size:14px; color:#555; margin:0; line-height:1.7; }
    .r-cta { background:linear-gradient(135deg,#1a1a2e 0%,#2d2d44 100%); color:#fff; padding:40px 32px; border-radius:14px; margin-top:48px; text-align:center; }
    .r-cta h3 { font-family:'Playfair Display',serif; font-size:24px; margin:0 0 10px; }
    .r-cta p { color:rgba(255,255,255,0.75); margin:0 0 22px; font-size:15px; }
    .r-cta a { display:inline-block; background:linear-gradient(135deg,#c8a96e 0%,#b08d4a 100%); color:#fff; text-decoration:none; padding:12px 28px; border-radius:50px; font-weight:600; font-size:14px; }
    /* Lodge gallery */
    .lodge-block { margin:0 0 48px; padding:24px; background:#fafaf7; border-radius:12px; }
    .lodge-head { margin-bottom:18px; }
    .lodge-region { font-size:11px; letter-spacing:0.15em; text-transform:uppercase; color:#c8a96e; font-weight:600; }
    .lodge-name { font-family:'Playfair Display',serif; font-size:22px; color:#1a1a2e; margin:4px 0 6px; }
    .lodge-tagline { font-size:14px; color:#666; margin:0; line-height:1.6; }
    .lodge-gallery { display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:10px; margin-top:14px; }
    .lodge-shot { margin:0; border-radius:8px; overflow:hidden; background:#1a1a2e; position:relative; }
    .lodge-shot picture, .lodge-shot img { display:block; width:100%; height:160px; object-fit:cover; transition:transform 0.4s; }
    .lodge-shot:hover img { transform:scale(1.05); }
    .lodge-shot-hero picture, .lodge-shot-hero img { height:240px; }
    .lodge-shot-hero { grid-column:1 / -1; }
    .lodge-shot figcaption { font-size:11px; color:rgba(255,255,255,0.85); background:rgba(0,0,0,0.55); padding:6px 10px; position:absolute; bottom:0; left:0; right:0; }
    @media (max-width:640px) { .r-hero h1 { font-size:26px; } .r-hero { height:50vh; } .r-body { padding:32px 20px 60px; } .lodge-shot picture, .lodge-shot img { height:140px; } .lodge-shot-hero picture, .lodge-shot-hero img { height:200px; } }
  </style>
  <% if (route.sample) { %><link rel="stylesheet" href="/chongqing.css?v=20260914b"><% } %>
  <% if (route.city_slugs && route.city_slugs.includes('xishuangbanna')) { %><link rel="stylesheet" href="/xishuangbanna.css?v=20260923"><% } %>
<%- include('partials/ga') %>
  <script src="/cdn-fallback.js" defer></script>
</head>
<body class="<%= route.sample ? 'cq-route' : '' %>">
  <%- include("partials/header") %>
  <a id="langToggle" class="lang-toggle" hreflang="<%= lang === 'en' ? 'zh-CN' : 'en' %>" href="<%= lang === 'en' ? '/routes/' + route.slug : '/en/routes/' + route.slug %><%= route.sample && route.destination_zh === '重庆' ? '?v=20260914-cq' : '' %>"><%= lang === 'en' ? '中' : 'EN' %></a>

  <section class="r-hero">
    <picture>
      <source srcset="<%= cdnImage(route.hero_path.replace(/\.jpg$/, '.webp'), 1600) %>" type="image/webp">
      <img src="<%= cdnImage(route.hero_path, 1600) %>" alt="<%= lang === 'en' ? route.title_en : route.title_zh %>" loading="eager">
    </picture>
    <div class="scrim"></div>
    <div class="inner">
      <div class="breadcrumb">
        <a href="<%= lang === 'en' ? '/en' : '' %>/"><%= lang === 'en' ? 'Home' : '首页' %></a>
        &nbsp;·&nbsp; <a href="<%= lang === 'en' ? '/en' : '' %>/brands/<%= brand.slug %>"><%= lang === 'en' ? brand.name_en : brand.name_zh %></a>
        &nbsp;·&nbsp; <%= lang === 'en' ? route.region_en : route.region_zh %>
      </div>
      <h1><%= lang === 'en' ? route.title_en : route.title_zh %></h1>
      <p class="subtitle"><%= lang === 'en' ? route.subtitle_en : route.subtitle_zh %></p>
    </div>
  </section>

  <div class="r-meta">
    <div class="r-meta-inner">
      <span><b><%= lang === 'en' ? 'Duration' : '时长' %></b><%= lang === 'en' ? route.duration_en : route.duration_zh %></span>
      <span><b><%= lang === 'en' ? 'Route' : '行程路线' %></b><%= lang === 'en' ? route.route_en : route.route_zh %></span>
      <span><b><%= lang === 'en' ? 'Lodges' : '住宿' %></b><%= lang === 'en' ? route.lodge_en : route.lodge_zh %></span>
    </div>
  </div>

  <div class="r-body">
    <div class="r-tags">
      <% (route.tags || []).forEach(function(t) { %>
      <span><%= lang === 'en' ? t.en : t.zh %></span>
      <% }); %>
    </div>

    <div class="r-intro"><%= lang === 'en' ? route.intro_en : route.intro_zh %></div>

    <% if (route.sample) { %>
    <section class="cq-route-summary" aria-label="<%= lang === 'en' ? 'Sample planning summary' : '参考线路规划摘要' %>">
      <dl><div><dt><%= lang === 'en' ? 'PACE' : '行程节奏' %></dt><dd><%= lang === 'en' ? route.pace_en : route.pace_zh %></dd></div><div><dt><%= lang === 'en' ? 'WHO IT SUITS' : '适合人群' %></dt><dd><%= lang === 'en' ? route.fit_en : route.fit_zh %></dd></div></dl>
      <% if (route.important_zh) { %><p class="cq-route-notice"><%= lang === 'en' ? route.important_en : route.important_zh %></p><% } %>
      <nav class="cq-route-nav"><a href="<%= urlFor(route.destination_path, lang) %><%= route.destination_zh === '重庆' ? '?v=20260914-cq' : '' %>#sample-journeys">← <%= route.destination_zh === '重庆' ? (lang === 'en' ? 'Compare all three Chongqing journeys' : '返回重庆，比较三条线路') : (lang === 'en' ? 'Explore ' + route.destination_en : '返回' + route.destination_zh + '目的地') %></a><a href="#plan-this-journey" data-enquiry-cta="<%= route.destination_zh === '重庆' ? 'chongqing' : 'xishuangbanna' %>-route-summary"><%= lang === 'en' ? 'Tailor this journey' : '定制这条线路' %> →</a></nav>
    </section>
    <% } %>
    <% if (route.price_reference) { %><%- include('partials/sample-price', { sample: route, lang }) %><% } %>

    <% if (typeof lodgesWithGallery !== 'undefined' && lodgesWithGallery && lodgesWithGallery.length) { %>
    <h2 class="r-section-title"><%= lang === 'en' ? 'Where You Stay' : '住宿巡礼' %></h2>
    <% lodgesWithGallery.forEach(function(lodge) { %>
    <div class="lodge-block">
      <div class="lodge-head">
        <div class="lodge-region"><%= lang === 'en' ? lodge.region_en : lodge.region_zh %></div>
        <h3 class="lodge-name"><%= lang === 'en' ? lodge.name_en : lodge.name_zh %></h3>
        <p class="lodge-tagline"><%= lang === 'en' ? lodge.tagline_en : lodge.tagline_zh %></p>
      </div>
      <% if (lodge.gallery && lodge.gallery.length) { %>
      <div class="lodge-gallery">
        <% lodge.gallery.forEach(function(g, idx) { %>
        <figure class="lodge-shot<%= idx === 0 ? ' lodge-shot-hero' : '' %>">
          <picture>
            <source srcset="<%= cdnImage(g.path.replace(/\.jpg$/, '.webp'), 1000) %>" type="image/webp">
            <img src="<%= cdnImage(g.path, 1000) %>" alt="<%= lang === 'en' ? g.caption_en : g.caption_zh %>" loading="lazy" decoding="async">
          </picture>
          <figcaption><%= lang === 'en' ? g.caption_en : g.caption_zh %></figcaption>
        </figure>
        <% }); %>
      </div>
      <% } %>
    </div>
    <% }); %>
    <% } %>

    <% if (route.overview && route.overview.length) { %>
    <h2 class="r-section-title"><%= lang === 'en' ? 'Day-by-Day' : '行程概览' %></h2>
    <% route.overview.forEach(function(day) { %>
    <div class="r-day">
      <h3 class="r-day-head"><%= lang === 'en' ? day.day_en : day.day_zh %></h3>
      <% (day.items || []).forEach(function(item) { %>
      <div class="r-day-item">
        <h4><%= lang === 'en' ? item.title_en : item.title_zh %></h4>
        <p><%= lang === 'en' ? item.desc_en : item.desc_zh %></p>
      </div>
      <% }); %>
      <% if (day.stay_zh) { %><p class="cq-stay"><strong><%= lang === 'en' ? 'Tonight · ' : '当晚住宿 · ' %></strong><%= lang === 'en' ? day.stay_en : day.stay_zh %></p><% } %>
    </div>
    <% }); %>
    <% } %>

    <% if (route.arrangements) { %>
    <section class="xb-arrangements"><h2 class="r-section-title"><%= lang === 'en' ? 'Stay, travel and support' : '住宿、用车与服务' %></h2>
      <% route.arrangements.forEach(function(item) { %><article><h3><%= lang === 'en' ? item.title_en : item.title_zh %></h3><p><%= lang === 'en' ? item.text_en : item.text_zh %></p></article><% }); %>
      <details class="xb-coach"><summary><%= lang === 'en' ? 'View the reference coach and 2+1 seating' : '查看参考车型与2+1座椅布局' %></summary><figure><a href="/images/xishuangbanna/coach-reference.jpg" target="_blank" rel="noopener"><picture><source srcset="/images/xishuangbanna/coach-reference.webp" type="image/webp"><img src="/images/xishuangbanna/coach-reference.jpg" alt="<%= lang === 'en' ? 'Reference coach collage showing exterior and two-plus-one seats' : '参考客车外观、2+1座椅及车内设施拼图' %>" loading="lazy"></picture></a><figcaption><%= lang === 'en' ? 'Reference photos supplied for this sample; the actual vehicle is confirmed separately.' : '本线路提供的车型参考图，实际车辆另行确认。' %></figcaption></figure></details>
    </section>
    <section class="xb-inclusions"><div><h2><%= lang === 'en' ? 'Reference inclusions' : '参考包含' %></h2><ul><% (lang === 'en' ? route.included_en : route.included_zh).forEach(function(item) { %><li><%= item %></li><% }); %></ul></div><div><h2><%= lang === 'en' ? 'Not included' : '不包含' %></h2><ul><% (lang === 'en' ? route.excluded_en : route.excluded_zh).forEach(function(item) { %><li><%= item %></li><% }); %></ul></div></section>
    <% } %>
    <% if (route.planning_notes) { %><section class="cq-planning"><h2><%= lang === 'en' ? 'Before this becomes your journey' : '从参考行程，到你的旅程' %></h2><ul><% route.planning_notes.forEach(function(note) { %><li><%= lang === 'en' ? note.en : note.zh %></li><% }); %></ul></section><% } %>
    <% if (route.photo_credit) { %><p class="cq-photo"><a href="<%= route.photo_url %>" target="_blank" rel="noopener"><%= route.photo_credit %></a> · <a href="<%= route.photo_license_url %>" target="_blank" rel="noopener"><%= route.photo_license %></a> · <%= lang === 'en' ? 'Resized; display crop' : '已缩放，按版面裁切显示' %></p><% } %>

    <section class="route-enquiry" id="plan-this-journey">
      <div class="advisor-form-heading">
        <p class="advisor-kicker"><%= lang === 'en' ? 'MAKE THIS JOURNEY YOURS' : '让这趟旅程真正属于您' %></p>
        <h2><%= lang === 'en' ? 'Keep the spirit. Change every detail.' : '保留旅程的精神，重写每一个细节。' %></h2>
        <p><%= lang === 'en' ? 'Dates, pace, lodges and experiences are shaped around your party.' : '日期、节奏、住宿与体验，都可以围绕您的同行者重新设计。' %></p>
      </div>
      <div class="advisor-form-shell">
        <%- include('partials/enquiry-form', { variant: 'long', source: 'route-detail', route: route }) %>
      </div>
    </section>
  </div>

  <%- include("partials/footer") %>
</body>
</html>
